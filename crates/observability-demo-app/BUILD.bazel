load("//bazel:defs.bzl", "crate_binary", "crate_library", "crate_tests")

package(default_visibility = ["//visibility:public"])

# Consumed by `crate.from_cargo` (see //MODULE.bazel).
exports_files(["Cargo.toml"])

# Named for Cargo's lib target rather than the crate directory, because the
# `[[bin]]` below has the directory's name and one package cannot spell both.
crate_library(
    name = "observability_demo_app",
    # `build.rs` turns these into the prost types and the descriptor set that
    # `src/lib.rs` includes from `OUT_DIR`.
    build_script_data = glob(["proto/**"]),
)

# `bazel run //:demo -- --role produce`.
crate_binary(
    name = "observability-demo-app",
    crate_root = "src/main.rs",
    lib = ":observability_demo_app",
)

crate_tests(
    # Fifteen of the sixteen suites drive the built binary through its CLI.
    # Naming it in `data` is all that is needed: rules_rust defines
    # `CARGO_BIN_EXE_<output basename>` for every bin crate there, and defines
    # it for the compile, which is where `env!` reads it.
    #
    # The sixteenth suite reads the compose stack and dashboards the demo ships.
    data = [
        ":observability-demo-app",
        "//:demo_observability",
    ],
    lib = "observability_demo_app",
)
