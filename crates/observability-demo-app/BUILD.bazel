load("//bazel:defs.bzl", "crate_binary", "crate_library", "crate_tests")

package(default_visibility = ["//visibility:public"])

# Consumed by `crate.from_cargo` (see //MODULE.bazel).
exports_files(["Cargo.toml"])

crate_library(
    name = "observability-demo-app",
    # `build.rs` turns these into the prost types and the descriptor set that
    # `src/lib.rs` includes from `OUT_DIR`.
    build_script_data = glob(["proto/**"]),
)

# Cargo's `[[bin]]` name is `observability-demo-app` too, and one Bazel package
# cannot spell both that and the library. The binary takes the short name.
crate_binary(
    name = "demo",
    crate_root = "src/main.rs",
    lib = ":observability-demo-app",
)

crate_tests(
    # Every suite but one drives the built binary through its CLI. The
    # remaining one reads the compose stack and dashboards the demo ships.
    data = [
        ":demo",
        "//:demo_observability",
    ],
    lib = "observability-demo-app",
    # `rustc_env`, not `env`: the suites reach the binary through `env!`, which
    # rustc resolves while it compiles. A runtime-only `env` is not defined yet
    # at that point. `$(rootpath)` is runfiles-relative, and a Bazel test runs
    # from the runfiles root, so the baked string still resolves when it runs.
    rustc_env = {"CARGO_BIN_EXE_observability-demo-app": "$(rootpath :demo)"},
)
