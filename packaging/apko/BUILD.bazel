"""The observability demo application image.

apko assembles locked Chainguard Wolfi bases for both release architectures.
rules_img adds the Bazel-built application, creates the multi-platform index,
and owns local loading and registry delivery.
"""

load("@rules_apko//apko:defs.bzl", "apko_image")
load("@rules_img//img:convert.bzl", "image_manifest_from_oci_layout")
load("@rules_img//img:image.bzl", "image_index", "image_manifest")
load("@rules_img//img:layer.bzl", "file_metadata", "image_layer")
load("@rules_img//img:load.bzl", "image_load")
load("@rules_img//img:media_types.bzl", "GZIP_LAYER")
load("@rules_img//img:push.bzl", "image_push")
load("@rules_shell//shell:sh_test.bzl", "sh_test")

package(default_visibility = ["//visibility:public"])

config_setting(
    name = "linux_arm64",
    constraint_values = [
        "@platforms//cpu:aarch64",
        "@platforms//os:linux",
    ],
)

apko_image(
    name = "base_oci",
    config = "krabka-demo.yaml",
    contents = "@demo_base_lock//:contents",
    tag = "krabka-o11y-demo-base:amd64-locked",
)

apko_image(
    name = "base_arm64_oci",
    config = "krabka-demo.arm64.yaml",
    contents = "@demo_base_arm64_lock//:contents",
    tag = "krabka-o11y-demo-base:arm64-locked",
)

image_manifest_from_oci_layout(
    name = "base",
    src = ":base_oci",
    architecture = "amd64",
    layers = [GZIP_LAYER],
    os = "linux",
)

image_manifest_from_oci_layout(
    name = "base_arm64",
    src = ":base_arm64_oci",
    architecture = "arm64",
    layers = [GZIP_LAYER],
    os = "linux",
)

NONROOT = file_metadata(
    gid = 65532,
    mode = "0755",
    uid = 65532,
)

image_layer(
    name = "application_layer",
    srcs = {
        "/usr/bin/observability-demo-app": "//crates/observability-demo-app",
    },
    default_metadata = NONROOT,
    include_runfiles = False,
)

image_manifest(
    name = "image",
    base = select({
        ":linux_arm64": ":base_arm64",
        "//conditions:default": ":base",
    }),
    entrypoint = ["/usr/bin/observability-demo-app"],
    labels = {
        "org.opencontainers.image.description": "Instrumented workload for the Krabka observability demo",
        "org.opencontainers.image.licenses": "Apache-2.0",
        "org.opencontainers.image.source": "https://github.com/krabka-io/krabka-o11y-demo",
        "org.opencontainers.image.title": "krabka-o11y-demo",
        "org.opencontainers.image.url": "https://github.com/krabka-io/krabka-o11y-demo",
    },
    layers = [":application_layer"],
    target_compatible_with = ["@platforms//os:linux"],
    user = "65532:65532",
    working_dir = "/data",
)

filegroup(
    name = "image_manifest_blob",
    srcs = [":image"],
    output_group = "root_blob",
)

# Tags build this target. The split transition builds the same manifest once
# for each CPU architecture, then writes one OCI image index containing both.
image_index(
    name = "image_multiarch",
    manifests = [":image"],
    platforms = [
        "//:linux_amd64",
        "//:linux_arm64",
    ],
    tags = ["manual"],
)

filegroup(
    name = "image_multiarch_index_blob",
    srcs = [":image_multiarch"],
    output_group = "root_blob",
    tags = ["manual"],
)

sh_test(
    name = "image_binaries_test",
    size = "small",
    srcs = ["image_binaries_test.sh"],
    args = select({
        ":linux_arm64": [
            "arm64",
            "$(rootpath :image_manifest_blob)",
            "$(rootpath :application_layer)",
        ],
        "//conditions:default": [
            "amd64",
            "$(rootpath :image_manifest_blob)",
            "$(rootpath :application_layer)",
        ],
    }),
    data = [
        ":application_layer",
        ":image_manifest_blob",
    ],
)

image_load(
    name = "load",
    image = ":image",
    tag = "krabka-io/krabka-o11y-demo:dev",
)

image_push(
    name = "push",
    image = ":image",
    registry = "ghcr.io",
    repository = "krabka-io/krabka-o11y-demo",
)

image_push(
    name = "push_multiarch",
    image = ":image_multiarch",
    registry = "ghcr.io",
    repository = "krabka-io/krabka-o11y-demo",
    tags = ["manual"],
)
